# ---- 参考资料 / 阅读笔记（不入库）----
reference/

# ---- 数据（默认全忽略，仅放行"开箱即用"的最小交付集）----
# 原则：clone 后 Member 2/3/4/5 无需重跑管道即可直接开工。
# 放行的 = 下游直接消费的产物；忽略的 = 原始数据、消融对照、可一键生成的副本。
data/*
!data/processed/
!data/raw/
data/processed/*
data/raw/*

# 段落级坐标系（M3/M5 的锚点）
!data/processed/paragraphs.parquet
# 评测金标准
!data/processed/qa.parquet
!data/processed/qa_dataset.jsonl
!data/processed/manifest.json
!data/processed/manifest_qa.json
# 默认切分配置（512/0.2/soft）的 chunk 表 + 金标准映射
!data/processed/chunks/
data/processed/chunks/*
!data/processed/chunks/size512_ov102_soft/
data/processed/chunks/size512_ov102_soft/*
!data/processed/chunks/size512_ov102_soft/chunks.parquet
!data/processed/chunks/size512_ov102_soft/qa_with_gold.jsonl
!data/processed/chunks/size512_ov102_soft/manifest.json
# BGE tokenizer 单文件（重新跑 M1 管道必需，711 KB）
!data/raw/bge_tok/
data/raw/bge_tok/*
!data/raw/bge_tok/tokenizer.json

# PubMedQA-1k 副线（第二个数据集，留选择空间）
!data/raw/pubmedqa/
data/raw/pubmedqa/*
!data/raw/pubmedqa/ori_pqal.json
!data/processed/pubmedqa/
data/processed/pubmedqa/*
!data/processed/pubmedqa/paragraphs.parquet
!data/processed/pubmedqa/qa.parquet
!data/processed/pubmedqa/qa_dataset.jsonl
!data/processed/pubmedqa/manifest.json
!data/processed/pubmedqa/chunks/
data/processed/pubmedqa/chunks/*
!data/processed/pubmedqa/chunks/pubmedqa_512_ov102/
data/processed/pubmedqa/chunks/pubmedqa_512_ov102/*
!data/processed/pubmedqa/chunks/pubmedqa_512_ov102/chunks.parquet
!data/processed/pubmedqa/chunks/pubmedqa_512_ov102/qa_with_gold.jsonl
!data/processed/pubmedqa/chunks/pubmedqa_512_ov102/manifest.json

# 派生大文件：不直接入库，需时从 parquet / 原始数据重新生成
*.jsonl.bak
*.faiss
*.index
*.npy
*.pkl

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ---- 实验产物（图表可入库，日志不入库）----
logs/
runs/
wandb/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地会话 / 个人笔记（不入库）----
.workbuddy/

# --- PubMedQA 引文图语料（CG-RAG 扩图，源+耦合核心 ≈1.4k 篇，~2.7 MB）---
!data/processed/pubmedqa_graph/
data/processed/pubmedqa_graph/*
!data/processed/pubmedqa_graph/papers.parquet
!data/processed/pubmedqa_graph/chunks.parquet
!data/processed/pubmedqa_graph/graph_edges.parquet
!data/processed/pubmedqa_graph/qa.parquet
!data/processed/pubmedqa_graph/report.json
!data/processed/pubmedqa_graph/report_graph.json
!data/processed/pubmedqa_graph/source_papers.parquet
